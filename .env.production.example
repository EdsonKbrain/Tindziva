# Production environment for a VPS. deploy/provision.sh copies this file to .env
# and fills in APP_URL, APP_KEY and DB_PASSWORD. Complete the SMTP section by hand.

APP_NAME="Tindziva Comunicação & Ideias"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tindziva.co.mz
APP_TIMEZONE=Africa/Maputo

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tindziva
DB_USERNAME=tindziva
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public

# E-mails are sent during the request, so no queue worker is required.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# SMTP — fill in with the e-mail provider's details.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responder@tindziva.co.mz"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed when MEDIA_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
